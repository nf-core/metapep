/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/metapep -profile test_proteins_only,<docker/singularity>
 */

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function with direct protein FASTA input'

    // Input data
    input      = params.pipelines_testdata_base_path + 'metapep/samplesheets/v1.0/samplesheet.proteins_only.csv'
    pred_method = 'mhcnuggets'
}
