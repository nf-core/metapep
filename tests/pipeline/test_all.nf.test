nextflow_pipeline {

    name "Test Workflow METAPEP main.nf - test_all"
    script "main.nf"
    profile "test_all"
    tag "pipeline"
    tag "WITH_NCBI"
    test("test all input path including protein downloads") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert new File("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert new File("$outputDir/pipeline_info/nf_core_metapep_software_mqc_versions.yml").exists() },
                { assert snapshot(path("$outputDir/db_tables/alleles.tsv"),
                                path("$outputDir/db_tables/conditions_alleles.tsv"),
                                path("$outputDir/db_tables/conditions.tsv"),
                                path("$outputDir/db_tables/microbiomes_entities.tsv"),
                                path("$outputDir/db_tables/entities.tsv"),
                                path("$outputDir/db_tables/microbiomes.tsv")).match("db_tables") },

                // test unstable files for existence due to non-reproducible snapshots.
                // entrez downloads need fixed assembly ids as inputs to deliver reproducible results.

                { assert new File("$outputDir/db_tables/microbiomes_entities.no_weights.tsv").exists() },
                { assert new File("$outputDir/db_tables/microbiomes_entities.nucl.tsv").exists() },
                { assert new File("$outputDir/db_tables/entities_proteins.tsv").exists() },
                { assert new File("$outputDir/db_tables/proteins_peptides.tsv").exists() },
                { assert new File("$outputDir/db_tables/peptides.tsv.gz").exists() },
                { assert new File("$outputDir/db_tables/proteins.tsv.gz").exists() },
                { assert new File("$outputDir/db_tables/predictions.tsv.gz").exists() },
                { assert new File("$outputDir/db_tables/stats.tsv").exists() },

                { assert snapshot(path("$outputDir/entrez_data/microbiomes_entities.entrez.tsv")).match("entrez_data") },
                { assert new File("$outputDir/entrez_data/entities_proteins.entrez.tsv").exists() },
                { assert new File("$outputDir/entrez_data/proteins.entrez.tsv.gz").exists() },
                { assert new File("$outputDir/entrez_data/taxa_assemblies.tsv").exists() },

                { assert new File("$outputDir/figures/entity_binding_ratios.HLA-A_01_01.pdf").exists() },
                { assert new File("$outputDir/figures/entity_binding_ratios.with_points.HLA-A_01_01.pdf").exists() },
                { assert new File("$outputDir/figures/prediction_score_distribution.HLA-A_01_01.pdf").exists() },
                { assert new File("$outputDir/figures/entity_binding_ratios.HLA-B_07_02.pdf").exists() },
                { assert new File("$outputDir/figures/entity_binding_ratios.with_points.HLA-B_07_02.pdf").exists() },
                { assert new File("$outputDir/figures/prediction_score_distribution.HLA-B_07_02.pdf").exists() },

                { assert new File("$outputDir/prodigal/proteins.pred_1.bin.1.tsv.gz").exists() },
                { assert new File("$outputDir/prodigal/proteins.pred_1.bin.2.tsv.gz").exists() },
                { assert new File("$outputDir/prodigal/proteins.pred_2.tsv.gz").exists() }
            )

        }

    }

}
