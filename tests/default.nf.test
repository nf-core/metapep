nextflow_pipeline {

    name "Test Workflow METAPEP main.nf - test"
    script "main.nf"
    profile "test"
    tag "pipeline"
    tag "WITHOUT_NCBI"

    test("test assembly and bin input") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert new File("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert new File("$outputDir/pipeline_info/nf_core_metapep_software_mqc_versions.yml").exists() },
                { assert snapshot(path("$outputDir/db_tables/alleles.tsv"),
                                path("$outputDir/db_tables/conditions_alleles.tsv"),
                                path("$outputDir/db_tables/conditions.tsv"),
                                path("$outputDir/db_tables/entities_proteins.tsv"),
                                path("$outputDir/db_tables/entities.tsv"),
                                path("$outputDir/db_tables/microbiomes_entities.no_weights.tsv"),
                                path("$outputDir/db_tables/microbiomes_entities.nucl.tsv"),
                                path("$outputDir/db_tables/microbiomes_entities.tsv"),
                                path("$outputDir/db_tables/microbiomes.tsv"),
                                path("$outputDir/db_tables/proteins_peptides.tsv"),
                                path("$outputDir/db_tables/peptides.tsv.gz"),
                                path("$outputDir/db_tables/proteins.tsv.gz"),
                                path("$outputDir/db_tables/stats.tsv")).match("db_tables") },
                { assert snapshot(path("$outputDir/db_tables/predictions.tsv.gz").linesGzip.size()).match("predictions.tsv.gz")},
                // Updated assertions for new format: peptide_id\tallele_id\tprediction_score\trank
                { assert lines[0].toString() =~ /5160618\t0\.0\t0\.2048779556600308\t0\.769[0-9]/ },
                { assert lines[1].toString() =~ /541212\t0\.0\t0\.2049981385373683\t0\.663[0-9]/ },
                { assert lines[2].toString() =~ /3822460\t0\.0\t0\.2049400645837759\t0\.720[0-9]/ },
                { assert lines[3].toString() =~ /1388076\t0\.0\t0\.205071547307208\t0\.576[0-9]/ },
                { assert lines[4].toString() =~ /3614240\t0\.0\t0\.2048047004317907\t0\.813[0-9]/ },
                { assert lines[5].toString() =~ /3734970\t0\.0\t0\.2048852504467185\t0\.763[0-9]/ },
                { assert lines[6].toString() =~ /3780524\t0\.0\t0\.2051366784162476\t0\.489[0-9]/ },
                { assert lines[7].toString() =~ /1073918\t0\.0\t0\.2043648658870143\t0\.938[0-9]/ },
                { assert lines[8].toString() =~ /1994792\t0\.0\t0\.2049709648937596\t0\.691[0-9]/ },
                { assert lines[9].toString() =~ /1872060\t0\.0\t0\.2051467157491155\t0\.475[0-9]/ },
                { assert new File("$outputDir/figures/entity_binding_ratios.HLA-A_01_01.pdf").exists() },
                { assert new File("$outputDir/figures/entity_binding_ratios.with_points.HLA-A_01_01.pdf").exists() },
                { assert new File("$outputDir/figures/prediction_score_distribution.HLA-A_01_01.pdf").exists() },
                { assert new File("$outputDir/figures/entity_binding_ratios.HLA-B_07_02.pdf").exists() },
                { assert new File("$outputDir/figures/entity_binding_ratios.with_points.HLA-B_07_02.pdf").exists() },
                { assert new File("$outputDir/figures/prediction_score_distribution.HLA-B_07_02.pdf").exists() },
                { assert snapshot(path("$outputDir/logs/prediction_warnings.log"),
                                path("$outputDir/logs/SUCCEEDED_unify_peptide_lengths.log")).match("logs") },
                { assert new File("$outputDir/prodigal/proteins.pred_0.bin.1.tsv.gz").exists() },
                { assert new File("$outputDir/prodigal/proteins.pred_0.bin.2.tsv.gz").exists() },
                { assert new File("$outputDir/prodigal/proteins.pred_1.tsv.gz").exists() }
            )
        }

    }

}
